{%- if section.settings.enabled -%}
  <div
    class="popup-newsletter"
    data-popup-newsletter
    data-popup-delay="{{ section.settings.delay_seconds | default: 3 }}"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="PopupNewsletterHeading"
    hidden
    inert
  >
    <div class="popup-newsletter__backdrop" data-popup-close></div>

    <div class="popup-newsletter__panel" role="document">
      <button
        type="button"
        class="popup-newsletter__close"
        data-popup-close
        aria-label="Close"
      >
        {% render 'icon', icon: 'close' %}
      </button>

      <div class="popup-newsletter__body">
        {%- if section.settings.eyebrow != blank -%}
          <div class="eyebrow popup-newsletter__eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}

        <h2 id="PopupNewsletterHeading" class="popup-newsletter__heading">
          {{ section.settings.heading }}
        </h2>

        {%- if section.settings.subheading != blank -%}
          <p class="popup-newsletter__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}

        <div class="popup-newsletter__form-wrap" data-popup-form-wrap>
          {%- form 'customer', id: 'PopupNewsletter', class: 'popup-newsletter__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter, popup-discount">
            <label class="visually-hidden" for="PopupNewsletterEmail">Email</label>
            <div class="popup-newsletter__row">
              <input
                id="PopupNewsletterEmail"
                type="email"
                name="contact[email]"
                placeholder="{{ section.settings.placeholder | default: 'you@example.com' }}"
                autocomplete="email"
                required
              >
              <button type="submit" class="button popup-newsletter__submit">
                {{ section.settings.button_label | default: 'Get my code' }}
              </button>
            </div>

            {%- if form.errors -%}
              <div class="popup-newsletter__error" data-popup-error role="alert">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            {%- if form.posted_successfully? and form.errors == blank -%}
              <template data-popup-success>
                <p class="popup-newsletter__success" tabindex="-1">
                  <strong>AEWELCOME10</strong><br>
                  {{ 'newsletter.popup_code_instruction' | t }}
                </p>
                {%- if section.settings.success_message != blank -%}
                  <p class="popup-newsletter__fine-print">{{ section.settings.success_message }}</p>
                {%- endif -%}
              </template>
            {%- endif -%}
          {%- endform -%}
        </div>

        {%- if section.settings.fine_print != blank -%}
          <p class="popup-newsletter__fine-print">{{ section.settings.fine_print }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script>
    (function () {
      var popup = document.querySelector('[data-popup-newsletter]');
      if (!popup) return;

      var STORAGE_KEY = 'ae:popup-newsletter:dismissed';
      var SUCCESS_KEY = 'ae:popup-newsletter:signed-up';
      var SUBMISSION_KEY = 'ae:popup-newsletter:submitted';
      var form = popup.querySelector('#PopupNewsletter');
      var submitted = false;

      try {
        var submittedAt = Number(sessionStorage.getItem(SUBMISSION_KEY));
        submitted = submittedAt > 0 && Date.now() - submittedAt < 15 * 60 * 1000;
        sessionStorage.removeItem(SUBMISSION_KEY);
      } catch (e) {}

      window.addEventListener('submit', function (event) {
        if (event.target !== form) return;
        try { sessionStorage.setItem(SUBMISSION_KEY, String(Date.now())); } catch (e) {}
      }, true);

      function isDismissed() {
        try { return localStorage.getItem(STORAGE_KEY) === '1'; } catch (e) { return false; }
      }
      function markDismissed() {
        try { localStorage.setItem(STORAGE_KEY, '1'); } catch (e) {}
      }
      function isSignedUp() {
        try { return localStorage.getItem(SUCCESS_KEY) === '1'; } catch (e) { return false; }
      }
      function markSignedUp() {
        try { localStorage.setItem(SUCCESS_KEY, '1'); } catch (e) {}
      }

      function open() {
        if (document.querySelector('[role="dialog"][aria-hidden="false"], [data-search-drawer].is-open, [data-garage-drawer].is-open') || document.body.classList.contains('is-menu-open')) {
          setTimeout(open, 1000);
          return;
        }
        popup.hidden = false;
        popup.inert = false;
        popup.setAttribute('aria-hidden', 'false');
        document.body.classList.add('is-popup-open');
        popup.dispatchEvent(new CustomEvent('ae:open-modal', { bubbles: true }));
        var focusTarget = popup.querySelector('.popup-newsletter__success, input[type="email"]');
        if (focusTarget) setTimeout(function () { focusTarget.focus(); }, 50);
      }

      function close() {
        popup.dispatchEvent(new CustomEvent('ae:modal-closed', { bubbles: true }));
        popup.setAttribute('aria-hidden', 'true');
        popup.hidden = true;
        document.body.classList.remove('is-popup-open');
        markDismissed();
      }

      popup.addEventListener('ae:close-modal', close);

      popup.addEventListener('click', function (evt) {
        if (evt.target.closest('[data-popup-close]')) close();
      });

      document.addEventListener('keydown', function (evt) {
        if (evt.key === 'Escape' && !popup.hidden) close();
      });

      var success = popup.querySelector('[data-popup-success]');
      var popupReturn = !window.location.hash || window.location.hash === '#PopupNewsletter';
      if (success && submitted && popupReturn) {
        form.replaceWith(success.content.cloneNode(true));
        var subheading = popup.querySelector('.popup-newsletter__subheading');
        if (subheading) subheading.hidden = true;
        markSignedUp();
        open();
        return;
      }
      if (success) success.remove();

      if (popupReturn && popup.querySelector('[data-popup-error]')) {
        open();
        return;
      }

      if (isDismissed() || isSignedUp()) return;

      var delay = parseInt(popup.getAttribute('data-popup-delay'), 10) || 0;
      setTimeout(open, delay * 1000);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable popup",
      "default": true
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Delay before showing (seconds)",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Welcome"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% off your first order"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Join the list — we'll email you a code, plus drop alerts and build inspiration."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get my code"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks! Check your inbox for your code."
    },
    {
      "type": "textarea",
      "id": "fine_print",
      "label": "Fine print",
      "default": "One discount per customer. Unsubscribe anytime."
    }
  ],
  "presets": [
    {
      "name": "Newsletter popup"
    }
  ]
}
{% endschema %}
