{% render 'breadcrumbs' %}

<section class="ae-page-hero" style="--ae-page-image: url({{ 'autobahn-hero.svg' | asset_url }});">
  <div class="page-width ae-page-hero__inner">
    <div>
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="page-width ae-page-content">
    <div class="section-heading">
      <div>
        <div class="eyebrow">{{ section.settings.grid_eyebrow }}</div>
        <h2>{{ section.settings.grid_heading }}</h2>
      </div>
      <p>{{ section.settings.grid_text }}</p>
    </div>

    {%- assign post_blog = section.settings.blog -%}
    {%- if post_blog == blank -%}
      {%- assign post_blog = blogs['autobahn-blog'] -%}
    {%- endif -%}

    {%- assign post_fallback_images = 'fallback-build-1.jpg,fallback-promo-3.jpg,fallback-promo-2.jpg,fallback-image-text-euro-car.jpg,fallback-collection-4.jpg,fallback-collection-3.jpg' | split: ',' -%}
    <div class="ae-grid-3">
      {%- for article in post_blog.articles limit: 10 -%}
        <article class="ae-card ae-build-card">
          {%- if article.image != blank -%}
            <div class="ae-build-card__media" style="--ae-build-image: url({{ article.image | image_url: width: 900 }});"></div>
          {%- else -%}
            {%- assign placeholder_index = forloop.index0 | modulo: post_fallback_images.size -%}
            <div class="ae-build-card__media" style="--ae-build-image: url({{ post_fallback_images[placeholder_index] | asset_url }});"></div>
          {%- endif -%}
          <div class="ae-build-card__body">
            <div class="eyebrow">{{ article.published_at | date: '%b %d, %Y' }}</div>
            <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <p>{{ article.excerpt | default: article.content | strip_html | truncatewords: 28 }}</p>
            {%- if article.tags.size > 0 -%}
              <div class="ae-meta-row">
                {%- for tag in article.tags limit: 3 -%}
                  <span class="ae-pill">{{ tag }}</span>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </article>
      {%- else -%}
        <p>No posts yet. Check back soon.</p>
      {%- endfor -%}
    </div>

    {%- if post_blog.articles_count > 10 -%}
      <div class="ae-page-actions" style="margin-top: 2rem; justify-content: center;">
        <a class="button button--secondary" href="{{ post_blog.url }}">View blog history</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "AE.Blog page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Latest from AE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AE.Blog"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Hero text",
      "default": "Product updates, install guides, and stories from the Autobahn Essentials shop."
    },
    {
      "type": "text",
      "id": "grid_eyebrow",
      "label": "Grid eyebrow",
      "default": "Latest posts"
    },
    {
      "type": "text",
      "id": "grid_heading",
      "label": "Grid heading",
      "default": "Recent stories"
    },
    {
      "type": "textarea",
      "id": "grid_text",
      "label": "Grid text",
      "default": "The ten most recent posts from AE.Blog."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog source",
      "info": "Pick the blog that feeds the grid. Defaults to AE.Blog (handle: autobahn-blog) if unset."
    }
  ],
  "presets": [
    {
      "name": "AE.Blog page"
    }
  ]
}
{% endschema %}
