{% render 'breadcrumbs' %}

{%- if section.settings.hero_image != blank -%}
  {%- assign hero_image_url = section.settings.hero_image | image_url: width: 1600 -%}
{%- else -%}
  {%- assign hero_image_url = 'fallback-hero-bmw-m4.jpg' | asset_url -%}
{%- endif -%}

<section class="ae-page-hero" style="--ae-page-image: url({{ hero_image_url }});">
  <div class="page-width ae-page-hero__inner">
    <div>
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="page-width ae-page-content">
    <div class="section-heading">
      <div>
        <div class="eyebrow">{{ section.settings.grid_eyebrow }}</div>
        <h2>{{ section.settings.grid_heading }}</h2>
      </div>
    </div>

    {%- assign post_blog = section.settings.blog -%}
    {%- if post_blog == blank -%}
      {%- assign post_blog = blogs['autobahn-blog'] -%}
    {%- endif -%}

    {%- assign post_fallback_images = 'fallback-build-1.jpg,fallback-promo-3.jpg,fallback-promo-2.jpg,fallback-image-text-euro-car.jpg,fallback-collection-4.jpg,fallback-collection-3.jpg' | split: ',' -%}
    <div class="ae-blog-list">
      {%- for article in post_blog.articles limit: 10 -%}
        <article class="ae-blog-post">
          {%- if article.image != blank -%}
            {%- assign post_media_image = article.image | image_url: width: 1200 -%}
          {%- else -%}
            {%- assign placeholder_index = forloop.index0 | modulo: post_fallback_images.size -%}
            {%- assign post_media_image = post_fallback_images[placeholder_index] | asset_url -%}
          {%- endif -%}
          <a class="ae-blog-post__media" href="{{ article.url }}" style="--ae-blog-image: url({{ post_media_image }});" aria-label="{{ article.title | escape }}"></a>
          <div class="ae-blog-post__body">
            <div class="eyebrow">{{ article.published_at | date: '%b %d, %Y' }}</div>
            <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <p>{{ article.excerpt | default: article.content | strip_html | truncatewords: 42 }}</p>
            {%- if article.tags.size > 0 -%}
              <div class="ae-meta-row">
                {%- for tag in article.tags limit: 3 -%}
                  <span class="ae-pill">{{ tag }}</span>
                {%- endfor -%}
              </div>
            {%- endif -%}
            <a class="ae-blog-post__more" href="{{ article.url }}">Read post &rarr;</a>
          </div>
        </article>
      {%- else -%}
        <p>No posts yet. Check back soon.</p>
      {%- endfor -%}
    </div>

    <div class="ae-page-actions" style="margin-top: 2rem; justify-content: center;">
      <a class="button button--secondary" href="{{ post_blog.url }}">Post history</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AE.Blog page",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Upload a custom hero photo. Falls back to the BMW M4 sunset shot when empty."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Latest from AE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Autobahn Blog"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Hero text",
      "default": "Product updates, install guides, and stories from the Autobahn Essentials shop."
    },
    {
      "type": "text",
      "id": "grid_eyebrow",
      "label": "Grid eyebrow",
      "default": "Latest posts"
    },
    {
      "type": "text",
      "id": "grid_heading",
      "label": "Grid heading",
      "default": "Recent stories"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog source",
      "info": "Pick the blog that feeds the grid. Defaults to AE.Blog (handle: autobahn-blog) if unset."
    }
  ],
  "presets": [
    {
      "name": "AE.Blog page"
    }
  ]
}
{% endschema %}
