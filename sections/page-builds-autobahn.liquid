{% render 'breadcrumbs' %}

{%- liquid
  assign instagram_url = section.settings.instagram_url
  if instagram_url == blank
    assign instagram_url = 'https://www.instagram.com/autobahnessentials/'
  endif
-%}

<section class="ae-page-hero" style="--ae-page-image: url({{ 'autobahn-hero.svg' | asset_url }});">
  <div class="page-width ae-page-hero__inner">
    <div>
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
      <div class="ae-page-actions">
        <a class="button" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a>
        <a class="button button--secondary" href="{{ instagram_url }}" target="_blank" rel="noopener noreferrer">{{ section.settings.secondary_label }}</a>
      </div>
    </div>
    <div class="ae-page-stats" aria-label="Build page highlights">
      <div class="ae-page-stat"><strong>Turbo</strong><span>Power-focused upgrade paths</span></div>
      <div class="ae-page-stat"><strong>OEM+</strong><span>Clean daily-driver setups</span></div>
      <div class="ae-page-stat"><strong>Carbon</strong><span>Exterior styling and detail parts</span></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Builds page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Real builds. Real results."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AE Builds"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Hero text",
      "default": "Customer cars, shop inspiration, and upgrade paths built around Autobahn Essentials performance parts."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop Build Parts"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Follow Builds"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL",
      "default": "https://www.instagram.com/autobahnessentials/"
    }
  ],
  "presets": [
    {
      "name": "Builds page"
    }
  ]
}
{% endschema %}
